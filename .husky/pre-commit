#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit validation checks..."

# 1. Run backend linting
echo "🧹 Checking backend linting..."
npm run lint --prefix backend || { echo "❌ Backend linting failed! Please fix ESLint errors before committing."; exit 1; }

# 2. Run backend build check
echo "⚙️ Checking backend compilation..."
npm run build --prefix backend || { echo "❌ Backend build failed! Please fix compiler errors before committing."; exit 1; }

# 3. Run frontend build check
echo "🎨 Checking frontend compilation..."
npm run build --prefix frontend || { echo "❌ Frontend build failed! Please fix compiler errors before committing."; exit 1; }

echo "✅ All pre-commit checks passed! Proceeding with commit."
